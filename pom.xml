<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring-Boot-Parent liefert sinnvolle Defaults (Plugin-Versionen, UTF-8, JUnit5, ...) -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>spring-ai-demo</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-ai-demo</name>
    <description>Top-10 Spring AI Feature-Demo auf Spring Boot 4 / Java 21</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.0-M8</spring-ai.version>
        <!-- JUnit-Tags, die das Standard-'mvn verify' ueberspringt. Die mit
             @Tag("docker") markierten Integrationstests benoetigen eine
             Docker-Engine (Testcontainers) und laufen nur im separaten
             Workflow ci-docker.yml (dort via -Dtest.excludedGroups= -Dgroups=docker). -->
        <test.excludedGroups>docker</test.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring-AI-Starter für Anthropic/Claude: liefert ChatModel, ChatClient,
             Tool-Calling, Multimodalität und Chat-Memory-Autokonfiguration -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <!-- Advisor-Modul mit QuestionAnswerAdvisor (RAG) und dem VectorStore-Retrieval -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <!-- pgvector als persistenter VectorStore (Feature 17). Autokonfiguriert
             einen PgVectorStore (Extension 'vector', Tabelle + Index) auf der
             vorhandenen PostgreSQL-DataSource. Aktiv nur im Profil 'pgvector'
             (siehe DemoBeans/application-pgvector.properties); in den Tests bleibt
             der offline SimpleVectorStore aktiv. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Persistentes Chat-Memory: JdbcChatMemoryRepository + Schema-Init.
             Ersetzt das bisherige In-Memory-Repository (Feature 5). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>spring-dotenv</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- Spring Boot startet beim 'mvn spring-boot:run' den in compose.yaml
             definierten Postgres-Container automatisch und verdrahtet die
             DataSource selbst (Zero-Setup). Nur zur Laufzeit, nicht transitiv. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
            <scope>runtime</scope>
        </dependency>

        <!-- PostgreSQL-Treiber (Laufzeit) fuer die echte Anwendung -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 als eingebettete DB: fuer Tests UND fuer die Standardlaufzeit ohne
             Profil (kein Docker/Postgres noetig). Spring AI M8 bringt einen
             H2-Dialekt fuer das Chat-Memory-Schema mit. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test-Stack: JUnit 5, Mockito, Spring-Test, AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Reactor-Test für das Testen der Streaming-Endpunkte (Flux) -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers fuer den pgvector-Integrationstest (@Tag("docker")):
             faehrt eine echte pgvector-PostgreSQL hoch und verdrahtet sie via
             @ServiceConnection. Nur fuer den separaten ci-docker.yml-Workflow;
             das Standard-Quality-Gate ueberspringt diese Gruppe und bleibt offline.
             Versionen werden vom spring-boot-dependencies-BOM verwaltet. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>



    <build>
        <plugins>
            <!-- Erstellt ein ausführbares Fat-JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Schliesst die mit @Tag("docker") markierten Integrationstests aus
                 dem Standardlauf aus (siehe Property test.excludedGroups). Der
                 ci-docker.yml-Workflow hebt das per -Dtest.excludedGroups= auf und
                 waehlt die Gruppe gezielt mit -Dgroups=docker. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
